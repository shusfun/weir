{
  "name": "weir-monorepo",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --filter @weir/console dev",
    "build": "pnpm --filter @weir/console build",
    "check": "pnpm --filter @weir/console check",
    "test": "go test ./... && pnpm check",
    "release": "powershell -NoProfile -File deploy/build.ps1",
    "contracts:generate": "openapi-typescript packages/contracts/public.openapi.yaml -o apps/console/src/lib/contracts/public.gen.ts"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
