# Disposable localhost test container only; never use this credential in production.
user default on nopass ~* &* +@all
user weir on >local-test-only ~weir:* &weir:* -@all +ping +hello +get +set +del +getdel +incr +expire +scan +eval +evalsha +script|load +pttl +dump +restore +unlink +client|setinfo
